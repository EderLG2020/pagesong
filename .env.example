# Imagen principal del hero (audífonos).
# Opción 1: coloca el archivo en /public y usa la ruta relativa, p. ej. /images/headphones.webp
# Opción 2: una URL absoluta (CDN, Cloudinary, S3...)
VITE_HERO_IMAGE=/images/headphones.webp

# Datos de marca / contacto
VITE_BRAND_NAME=Pagesong
VITE_CONTACT_PHONE=+01 800 25923857
VITE_CONTACT_ADDRESS=100 Main St, New York NY 10002, USA

# Origen de los productos: "api" (DummyJSON + textos de /public/data/products.json) o "json" (solo local)
VITE_PRODUCTS_SOURCE=api

# Minutos que se guarda en caché (localStorage) la respuesta de la API de productos
VITE_CACHE_TTL_MINUTES=30

# URL pública del sitio, sin "/" final (canonical, Open Graph y JSON-LD)
VITE_SITE_URL=https://pagesong.netlify.app
